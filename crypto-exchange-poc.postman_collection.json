    {
      "name": "09 - Audit Log",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/audit/logs?limit=20",
              "host": ["{{base_url}}"],
              "path": ["audit", "logs"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array with hash fields', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data).to.be.an('array');",
                  "  if (data.length > 0) {",
                  "    pm.expect(data[0]).to.have.property('row_hash');",
                  "    pm.expect(data[0]).to.have.property('prev_hash');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Verify Audit Chain Integrity",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/audit/verify-chain",
              "host": ["{{base_url}}"],
              "path": ["audit", "verify-chain"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Chain integrity is OK', function () {",
                  "  var data = pm.response.json();",
                  "  pm.expect(data.integrity).to.equal('OK');",
                  "  pm.expect(data.checked).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Audit Logs — Filter by Event Type",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/audit/logs?event_type=API_KEY_CREATED&limit=10",
              "host": ["{{base_url}}"],
              "path": ["audit", "logs"],
