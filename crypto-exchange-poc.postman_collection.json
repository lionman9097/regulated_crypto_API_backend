    {
      "name": "03 - Orders",
      "item": [
        {
          "name": "Create Buy Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{user_id}},\n  \"symbol\": \"{{symbol}}\",\n  \"side\": \"buy\",\n  \"size\": {{order_size}},\n  \"leverage\": {{leverage}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": ["{{base_url}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 or 400', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "  var data = pm.response.json();",
                  "  if (data.order && data.order.order_id) {",
                  "    pm.collectionVariables.set('order_id', String(data.order.order_id));",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Cancel Order (if open)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}/cancel?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["orders", "{{order_id}}", "cancel"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{user_id}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
