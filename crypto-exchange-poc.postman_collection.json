    {
      "name": "08 - API Keys & Scope Enforcement",
      "item": [
        {
          "name": "Create API Key (scopes: read:market)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"postman-read-market-only\",\n  \"scopes\": [\"read:market\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api-keys",
              "host": ["{{base_url}}"],
              "path": ["api-keys"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test('Returns key_id and secret', function () {",
                  "  pm.expect(data.key_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.secret).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.scopes).to.include('read:market');",
                  "});",
                  "pm.collectionVariables.set('api_key_id', data.key_id);",
                  "pm.collectionVariables.set('api_key_secret', data.secret);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api-keys",
              "host": ["{{base_url}}"],
              "path": ["api-keys"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
