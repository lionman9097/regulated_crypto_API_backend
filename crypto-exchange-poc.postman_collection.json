                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Market Price with API Key (read:market — Expect 200)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key", "value": "{{api_key_id}}" },
              { "key": "X-API-Secret", "value": "{{api_key_secret}}" }
            ],
            "url": {
              "raw": "{{base_url}}/market/price/{{symbol}}",
              "host": ["{{base_url}}"],
              "path": ["market", "price", "{{symbol}}"]
